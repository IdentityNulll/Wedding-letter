# Copy to .env and fill in.

PORT=4000

# Local: mongodb://127.0.0.1:27017/wedding-letter
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/wedding-letter
MONGODB_URI=mongodb://127.0.0.1:27017/wedding-letter

# Password your client types to reach the admin panel.
ADMIN_PASSWORD=change-me-to-something-long

# Signs admin tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Where the React app is served from. Used for CORS and for the URL encoded
# into QR codes — get this wrong and you print QR codes pointing at localhost.
CLIENT_ORIGIN=http://localhost:5173
