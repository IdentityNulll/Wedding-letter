# Copy to .env.local and fill in.

# Password your client types to reach /admin.
ADMIN_PASSWORD=change-me-to-something-long

# Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public origin, used to build invitation URLs and QR codes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
